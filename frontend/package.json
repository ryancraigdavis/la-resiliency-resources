		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/vazirmatn": "^5.3.0",
		"@lucide/svelte": "^1.46.0",
